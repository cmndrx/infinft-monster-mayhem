rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Allow public read to everything by default
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /collections_onboarding/{allPaths=**} {
      allow read, write: if true;
    }

    // // Require auth for profile_images
    // match /profile_images/{file} {
    //   allow read, write: if request.auth != null;
    // }

//     // Require auth for gifs
//     match /gifs/{file} {
//       allow read, write: if request.auth != null;
//     }

//     // Require auth for soundtracks
//     match /soundtracks/{file} {
//       allow read, write: if request.auth != null;
//     }

    // Optionally: lock down write access to other public folders if needed
    // match /infinityCardImages/{file} {
    //   allow write: if request.auth != null; // Optional
    // }
  }
}
